  },
  "devDependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^4.1.4",
    "@arizeai/openinference-instrumentation-openai-agents": "^0.3.2",
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/cdp-sdk": "^1.57.1",
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "@goat-sdk/wallet-viem": "0.3.0",
    "@langchain/core": "^1.2.14",
    "@mastra/core": "^1.74.0",
    "@mastra/observability": "^1.18.3",
    "@mastra/otel-bridge": "^1.5.13",
    "@openai/agents": "^0.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@types/node": "^24.19.1",
    "ai": "^7.0.127",
    "langchain": "^1.5.15",
    "prool": "^0.2.16",
    "typescript": "^7.0.2",
    "viem": "^2.57.2",
