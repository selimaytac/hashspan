{
  "name": "hashspan",
  "private": true,
  "description": "OpenTelemetry tracing for on-chain transactions sent by AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm build && pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:all": "vitest run",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/publish-in-order.mjs",
    "version-packages": "changeset version && node scripts/sync-version.mjs && pnpm install --lockfile-only",
    "demo": "pnpm build && pnpm --filter @hashspan/example-ai-sdk-agent start",
    "demo:base-sepolia": "pnpm build && pnpm --filter @hashspan/example-ai-sdk-agent start:base-sepolia",
    "check:packages": "pnpm build && pnpm -r --filter \"./packages/*\" exec publint --strict && pnpm -r --filter \"./packages/*\" exec attw --pack . --profile node16",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.0.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "//": "tar: prool pins tar@7.2.0 but never imports it (https://github.com/wevm/prool/issues/112). Remove once prool drops or bumps it.",
    "overrides": {
      "tar": ">=7.5.21"
    }
  }
}
