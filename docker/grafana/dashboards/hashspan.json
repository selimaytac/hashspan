{
  "uid": "hashspan-overview",
  "title": "hashspan: sends, confirmations and fees",
  "tags": ["hashspan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "chain",
        "label": "Chain id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hashspan-prometheus"
        },
        "query": {
          "query": "label_values(blockchain_client_send_duration_seconds_count, blockchain_chain_id)",
          "refId": "chain"
        },
        "definition": "label_values(blockchain_client_send_duration_seconds_count, blockchain_chain_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sends in range",
      "description": "Transactions, user operations and call batches sent in the selected time range. Counted per run without extrapolation: each run of the example agent is a series of its own (service.instance.id) that starts at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum((max_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__range]) - min_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed sends in range",
      "description": "Sends that ended with an error.type in the selected time range. Counted per run without extrapolation: each run of the example agent is a series of its own (service.instance.id) that starts at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum((max_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__range]) - min_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__range]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Confirmation p95 in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (max_over_time(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__range]) - min_over_time(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Median fee in range",
      "description": "Total fee per transaction (blockchain.client.fee, recorded in wei), from the sealed receipt; shown in gwei.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gwei",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (max_over_time(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__range]) - min_over_time(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__range]))) / 1e9",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Confirmation latency per chain",
      "description": "blockchain.client.confirmation.duration: from the send to the receipt.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p99 chain {{blockchain_chain_id}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Send latency per chain",
      "description": "blockchain.client.send.duration: until the node, bundler or wallet returned a hash.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_send_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_send_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fee per chain",
      "description": "blockchain.client.fee: total fee of each confirmed transaction, including the L1 fee on OP-stack chains; recorded in wei, shown in gwei.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gwei",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "(histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__rate_interval])))) / 1e9",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__rate_interval])))) / 1e9",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Fee distribution in range",
      "description": "Confirmed transactions whose total fee (blockchain.client.fee, in wei) is at most each bucket bound. Counted per run without extrapolation: each run of the example agent is a series of its own (service.instance.id) that starts at zero. Buckets without a transaction are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sort(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sum by (le) (max_over_time(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__range]) - min_over_time(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\",blockchain_fee_payer=\"\"}[$__range])), \"bound\", \"up to 1e8 wei\", \"le\", \"100000000\"), \"bound\", \"up to 1e9 wei\", \"le\", \"1000000000\"), \"bound\", \"up to 1e10 wei\", \"le\", \"10000000000\"), \"bound\", \"up to 1e11 wei\", \"le\", \"100000000000\"), \"bound\", \"up to 1e12 wei\", \"le\", \"1000000000000\"), \"bound\", \"up to 1e13 wei\", \"le\", \"10000000000000\"), \"bound\", \"up to 1e14 wei\", \"le\", \"100000000000000\"), \"bound\", \"up to 1e15 wei\", \"le\", \"1000000000000000\"), \"bound\", \"up to 1e16 wei\", \"le\", \"10000000000000000\"), \"bound\", \"up to 1e17 wei\", \"le\", \"100000000000000000\"), \"bound\", \"up to 1e18 wei\", \"le\", \"1000000000000000000\"), \"bound\", \"any fee\", \"le\", \"\\\\+Inf\") > 0)",
          "instant": true,
          "legendFormat": "{{bound}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Send failures by error.type in range",
      "description": "Sends that failed, by error.type. Counted per run without extrapolation: each run of the example agent is a series of its own (service.instance.id) that starts at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum by (error_type) (max_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__range]) - min_over_time(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__range]))",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Confirmation outcomes in range",
      "description": "blockchain.tx.status from chain data, or error.type when the observer gave up (ADR 0016). Counted per run without extrapolation: each run of the example agent is a series of its own (service.instance.id) that starts at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(sum by (blockchain_operation_subject, blockchain_tx_status, blockchain_user_operation_success, blockchain_call_batch_status, error_type) (max_over_time(blockchain_client_confirmation_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__range]) - min_over_time(blockchain_client_confirmation_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__range])), \"blockchain_operation_subject\", \"transaction\", \"blockchain_operation_subject\", \"\"), \"user_operation_outcome\", \"success\", \"blockchain_user_operation_success\", \"true\"), \"user_operation_outcome\", \"reverted\", \"blockchain_user_operation_success\", \"false\")",
          "legendFormat": "{{blockchain_operation_subject}} {{blockchain_tx_status}}{{user_operation_outcome}}{{blockchain_call_batch_status}}{{error_type}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Traces",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Each sample comes from a `send` or `confirm` span: open [Jaeger](http://localhost:16686/search?service=treasury-agent) to see the transactions behind these numbers."
      }
    }
  ]
}
