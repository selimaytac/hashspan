{
  "uid": "hashspan-overview",
  "title": "hashspan: sends, confirmations and fees",
  "tags": ["hashspan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "chain",
        "label": "Chain id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hashspan-prometheus"
        },
        "query": {
          "query": "label_values(blockchain_client_send_duration_seconds_count, blockchain_chain_id)",
          "refId": "chain"
        },
        "definition": "label_values(blockchain_client_send_duration_seconds_count, blockchain_chain_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sends in range",
      "description": "Transactions, user operations and call batches sent in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "round(sum(increase(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__range])))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed sends in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "round(sum(increase(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__range])) or vector(0))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Confirmation p95 in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__range])))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Median fee in range",
      "description": "Total fee per transaction (blockchain.client.fee, recorded in wei), from the sealed receipt; shown in gwei.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gwei",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "(histogram_quantile(0.5, sum by (le) (increase(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\"}[$__range])))) / 1e9",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Confirmation latency per chain",
      "description": "blockchain.client.confirmation.duration: from the send to the receipt.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, blockchain_chain_id) (rate(blockchain_client_confirmation_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p99 chain {{blockchain_chain_id}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Send latency per chain",
      "description": "blockchain.client.send.duration: until the node, bundler or wallet returned a hash.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_send_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_send_duration_seconds_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fee per chain",
      "description": "blockchain.client.fee: total fee of each confirmed transaction, including the L1 fee on OP-stack chains; recorded in wei, shown in gwei.",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gwei",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "(histogram_quantile(0.5, sum by (le, blockchain_chain_id) (rate(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))) / 1e9",
          "legendFormat": "p50 chain {{blockchain_chain_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, blockchain_chain_id) (rate(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval])))) / 1e9",
          "legendFormat": "p95 chain {{blockchain_chain_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Fee distribution (wei buckets)",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "none"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Blues"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum by (le) (increase(blockchain_client_fee_bucket{blockchain_chain_id=~\"$chain\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Send failures by error.type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum by (error_type) (increase(blockchain_client_send_duration_seconds_count{blockchain_chain_id=~\"$chain\",error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Confirmation outcomes",
      "description": "blockchain.tx.status from chain data, or error.type when the observer gave up (ADR 0016).",
      "datasource": {
        "type": "prometheus",
        "uid": "hashspan-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hashspan-prometheus"
          },
          "expr": "sum by (blockchain_tx_status, error_type) (increase(blockchain_client_confirmation_duration_seconds_count{blockchain_chain_id=~\"$chain\"}[$__rate_interval]))",
          "legendFormat": "{{blockchain_tx_status}}{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Traces",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Each sample comes from a `send` or `confirm` span: open [Jaeger](http://localhost:16686/search?service=treasury-agent) to see the transactions behind these numbers."
      }
    }
  ]
}
