{
  "name": "@hashspan/core",
  "version": "0.1.0",
  "description": "Transaction lifecycle tracing for on-chain actions of AI agents, built on OpenTelemetry.",
  "license": "Apache-2.0",
  "author": "Selim Aytac",
  "homepage": "https://github.com/selimaytac/hashspan/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/selimaytac/hashspan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimaytac/hashspan.git",
    "directory": "packages/core"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "blockchain",
    "evm",
    "ai-agents",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0"
  },
  "engines": {
    "node": ">=18"
  }
}
