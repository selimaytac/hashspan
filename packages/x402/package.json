{
  "name": "@hashspan/x402",
  "version": "0.7.0",
  "description": "x402 adapter for @hashspan/core: traces the payments an AI agent makes over x402 as payment spans.",
  "license": "Apache-2.0",
  "author": "Selim Aytac",
  "homepage": "https://github.com/selimaytac/hashspan/tree/main/packages/x402#readme",
  "bugs": {
    "url": "https://github.com/selimaytac/hashspan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimaytac/hashspan.git",
    "directory": "packages/x402"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "x402",
    "payments",
    "evm",
    "ai-agents",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hashspan/core": "workspace:^",
    "@hashspan/viem": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@x402/core": "^2.13.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "prool": "^0.2.16",
    "viem": "^2.57.2"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
