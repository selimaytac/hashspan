{
  "name": "@hashspan/mpp",
  "version": "0.1.1",
  "description": "OpenTelemetry instrumentation for MPP payments made with mppx: traces the payments an AI agent makes with the Machine Payments Protocol as payment spans.",
  "license": "Apache-2.0",
  "author": "Selim Aytac",
  "homepage": "https://hashspan.dev",
  "bugs": {
    "url": "https://github.com/selimaytac/hashspan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimaytac/hashspan.git",
    "directory": "packages/mpp"
  },
  "keywords": [
    "opentelemetry",
    "opentelemetry-instrumentation",
    "otel",
    "mpp",
    "mppx",
    "tempo",
    "payments",
    "tracing",
    "observability",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hashspan/core": "workspace:^",
    "@hashspan/viem": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "mppx": "~0.13.5",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "mppx": "~0.13.5",
    "prool": "^0.2.16",
    "viem": "^2.57.2"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
