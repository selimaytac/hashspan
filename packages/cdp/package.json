{
  "name": "@hashspan/cdp",
  "version": "1.0.0",
  "description": "Coinbase CDP adapter for @hashspan/core: traces transactions of CDP server accounts and user operations of smart accounts.",
  "license": "Apache-2.0",
  "author": "Selim Aytac",
  "homepage": "https://hashspan.dev",
  "bugs": {
    "url": "https://github.com/selimaytac/hashspan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimaytac/hashspan.git",
    "directory": "packages/cdp"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "coinbase",
    "cdp",
    "evm",
    "transactions",
    "ai-agents",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hashspan/core": "workspace:^",
    "@hashspan/viem": "workspace:^"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": "^1.57.0",
    "@opentelemetry/api": "^1.9.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.57.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "prool": "^0.2.16",
    "typescript": "^7.0.2",
    "viem": "^2.57.2"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
