{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!integrations/test/hardhat/artifacts",
      "!packages/core/test/fixtures/backends-e7",
      "!docs/backends/results",
      "!docs/bundlers/results",
      "!docs/facilitators/results",
      "!docs/nodes/results",
      "!scripts/nodes/execution-apis",
      "!scripts/bundlers/corpus.json",
      "!scripts/facilitators/corpus.json",
      "!**/.changeset/*.md",
      "!**/CHANGELOG.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["packages/*/test/readme/**", "integrations/test/readme/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ]
}
